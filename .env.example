# Copy to .env and supply credentials externally. Never commit real secrets.
# Auth cookies require HTTPS outside the explicit local Spring profile.
IMAGE_TAG=latest
# Required independent database image tag for Compose deployments.
MYSQL_IMAGE_TAG=
# Fixed Docker topology (validated; do not use root).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chinese_online_learning
MYSQL_USER=chinese_app
MYSQL_PASSWORD=
SERVER_PORT=8081

# JWT_SECRET must be Base64 of at least 32 random bytes: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
# Refresh sessions have an absolute expiry; rotation does not extend this duration.
JWT_REFRESH_TTL=P30D
# Lax for same-site deployment. None requires HTTPS and exact credentialed CORS.
AUTH_COOKIE_SAME_SITE=Lax



GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Replace the example HTTPS origin with the exact public frontend origin.
# This is the FRONTEND landing page, NOT the provider callback.
# Local HTTP development uses SPRING_PROFILES_ACTIVE=local and localhost frontend URLs.
OAUTH2_FRONTEND_REDIRECT_URI=https://learning.example.com/oauth/callback


CORS_ALLOWED_ORIGINS=https://learning.example.com
FRONTEND_VERIFY_EMAIL_URL=https://learning.example.com/verify-email
FRONTEND_PAYMENT_RESULT_URL=https://learning.example.com/payment/result
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CREATE_PAYMENT_URL=https://api-merchant.payos.vn/v2/payment-requests
PAYOS_PAYMENT_REQUEST_URL=https://api-merchant.payos.vn/v2/payment-requests

MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Empty MAIL_FROM_EMAIL falls back to SMTP_USERNAME in Compose.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Chinese Online Learning
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_BASE_URL=https://api.resend.com

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
# Phase 2 on Ubuntu only, after certificate issuance:
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
