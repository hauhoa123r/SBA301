+# Enable only after both DNS records and this certificate are verified.
+server {
+    listen 80 default_server;
+    server_name edujar.site www.edujar.site;
+    location /.well-known/acme-challenge/ { root /var/www/certbot; }
+    location / { return 301 https://edujar.site$request_uri; }
+}
+server {
+    listen 443 ssl;
+    server_name edujar.site www.edujar.site;
+    ssl_certificate /etc/letsencrypt/live/edujar.site/fullchain.pem;
+    ssl_certificate_key /etc/letsencrypt/live/edujar.site/privkey.pem;
+    ssl_protocols TLSv1.2 TLSv1.3;
+    root /usr/share/nginx/html;
+    index index.html;
+    location /.well-known/acme-challenge/ { root /var/www/certbot; }
+    location = /api/actuator/health { proxy_pass http://backend:8081/actuator/health; }
+    location /api/actuator { return 404; }
+    location /actuator { return 404; }
+    location /api/ {
+        proxy_pass http://backend:8081;
+        include /etc/nginx/proxy_params;
+    }
+    location /login/oauth2/ {
+        proxy_pass http://backend:8081;
+        include /etc/nginx/proxy_params;
+    }
+    location / { try_files $uri $uri/ /index.html; }
+}

